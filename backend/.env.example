# Generate a strong value for production:  openssl rand -base64 48
# The server refuses to start in production if this is missing, weak, or < 32 chars.
JWT_SECRET=change-me-in-production

PORT=3001
MONGODB_URI=mongodb://localhost:27017/clickup-clone

# Frontend origin. Used for invite links and as the default CORS allow-list.
FRONTEND_URL=http://localhost:5173

# Production only:
# NODE_ENV=production
# CORS_ORIGINS=https://your-frontend-domain.com   # comma-separated; overrides FRONTEND_URL for CORS

# Gmail SMTP for sending real invite emails (App Password, not your real password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
